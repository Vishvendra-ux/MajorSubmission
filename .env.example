# ==============================================================================
# SUMIND-IQ — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and replace placeholder values before running.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# --- Application Settings ---
APP_NAME=SUMIND-IQ
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-cryptographically-random-64-char-hex-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- CORS & Frontend Origin ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# --- Authoritative Relational Database (PostgreSQL + pgvector) ---
# Production / Docker Compose PostgreSQL URI:
DATABASE_URL=postgresql+psycopg2://sumindiq:sumindiq_dev_password@localhost:5432/sumindiq
# Development fallback (used only when PostgreSQL is unavailable in local dev):
DEV_FALLBACK_SQLITE_URL=sqlite:///./data/sumindiq_dev.db
ALLOW_DEV_DB_FALLBACK=true

# --- Document Structure & Ingestion Metadata Store (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sumindiq_docs
ALLOW_DEV_MONGO_FALLBACK=true
DEV_MONGO_FALLBACK_DIR=./data/mongo_fallback

# --- Queue, Cache & Rate Limiting (Redis / Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
ALLOW_IN_PROCESS_WORKER_FALLBACK=true

# --- File Storage & Ingestion Limits ---
STORAGE_DIR=./storage/documents
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200
SIGNED_DOWNLOAD_TTL_SECONDS=300
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# --- AI & RAG Configuration ---
# Supported LLM_PROVIDER values: gemini | openai_compatible | extractive_grounded | mock_test
# Note: If LLM_API_KEY is empty and LLM_PROVIDER is gemini/openai_compatible, the platform
# reports provider configuration status clearly and falls back to extractive_grounded only when explicitly enabled.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
ALLOW_EXTRACTIVE_GROUNDED_FALLBACK=true

# Supported EMBEDDING_PROVIDER values: gemini | openai_compatible | local_deterministic
EMBEDDING_PROVIDER=local_deterministic
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=384
RAG_TOP_K=6
RAG_MIN_SIMILARITY_SCORE=0.18

# --- Email / Password Reset Provider ---
# Supported EMAIL_PROVIDER values: console_dev | smtp
EMAIL_PROVIDER=console_dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@sumind-iq.internal

# --- Security & Rate Limiting ---
AUTH_RATE_LIMIT_PER_MINUTE=15
API_RATE_LIMIT_PER_MINUTE=120
CONVERSATION_RETENTION_DAYS=365

# --- Frontend Build Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

