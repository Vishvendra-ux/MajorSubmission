# ==============================================================================
# SUMIND-IQ — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and replace placeholder values before running.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# --- Application Settings ---
APP_NAME=SUMIND-IQ
APP_ENV=development
APP_DEBUG=false
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-cryptographically-random-64-char-hex-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- CORS & Frontend Origin ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

# --- Database & Vector Search (MongoDB + MongoDB Atlas Vector Search) ---
# Production / Atlas URI (e.g., mongodb+srv://<user>:<pass>@cluster.mongodb.net):
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=sumindiq_db
MONGODB_VECTOR_INDEX_NAME=chunk_vector_index
# Development fallback (used only when a MongoDB daemon/Atlas is unreachable locally):
ALLOW_LOCAL_MONGO_FALLBACK=true
LOCAL_MONGO_STORE_PATH=./data/mongodb_store.json

# --- File Storage (AWS S3 with Local Disk Fallback) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sumind-iq-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional custom S3-compatible endpoint (e.g., MinIO / Cloudflare R2):
AWS_S3_ENDPOINT=
STORAGE_DIR=./storage/documents
MAX_UPLOAD_SIZE_MB=25
SIGNED_DOWNLOAD_TTL_SECONDS=300

# --- Background Jobs (BullMQ + Redis) ---
REDIS_URL=redis://127.0.0.1:6379/0
BULLMQ_QUEUE_NAME=sumindiq-ingestion-queue
ALLOW_IN_PROCESS_WORKER_FALLBACK=true

# --- Document Processing & OCR (PDF.js, Mammoth.js, SheetJS, Tesseract.js) ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200
OCR_ENABLED=true

# --- AI Integration (LLM API + JavaScript Embedding SDK/API) ---
# Supported LLM_PROVIDER values: gemini | extractive_grounded
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=45
ALLOW_EXTRACTIVE_GROUNDED_FALLBACK=true

# Supported EMBEDDING_PROVIDER values: gemini | js_semantic_sdk
EMBEDDING_PROVIDER=js_semantic_sdk
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=384
RAG_TOP_K=6
RAG_MIN_SIMILARITY_SCORE=0.15

# --- Email / Password Reset Provider ---
# Supported EMAIL_PROVIDER values: console_dev | smtp
EMAIL_PROVIDER=console_dev

# --- Security & Rate Limiting ---
AUTH_RATE_LIMIT_PER_MINUTE=35
API_RATE_LIMIT_PER_MINUTE=240
CONVERSATION_RETENTION_DAYS=365

# --- Frontend Build Variables (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
